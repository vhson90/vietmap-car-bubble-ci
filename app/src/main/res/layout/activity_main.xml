<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header (Chạm 5 lần liên tiếp vào tiêu đề để mở khóa Menu Debug Giả lập cho Developer) -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VELOHUD v3.0 • MINI HUD OFFLINE"
            android:textColor="#38BDF8"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="⚪ Đang kiểm tra quyền hệ thống..."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Nút cấp quyền & Bật/Tắt Bong Bóng -->
        <Button
            android:id="@+id/btnGrantPermissions"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#D97706"
            android:text="🔑 CẤP QUYỀN GPS &amp; VẼ BONG BÓNG NỔI TRÊN MÀN HÌNH XE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnToggleBubble"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#0284C7"
            android:text="🚀 BẬT BONG BÓNG TỐC ĐỘ NỔI"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Card 1: Telemetry Trực Tiếp (GPS Thực Tế với Thuật toán lọc Hybrid Doppler + Geodesic) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛰️ ĐỒNG HỒ VẬN TỐC XE &amp; BIỂN BÁO GPS THỰC TẾ"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLiveSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 km/h"
                    android:textColor="#38BDF8"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivLiveLimitSign"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="Biển báo giới hạn"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLiveZoneName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đô thị tiêu chuẩn (60 km/h)"
                        android:textColor="#F8FAFC"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLiveUpcomingAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Đang thu tín hiệu vệ tinh GPS &amp; quét 69,965 biển báo..."
                        android:textColor="#34D399"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvLiveCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="GPS: Chưa khóa vệ tinh • Lọc vận tốc: Hybrid Doppler + Geodesic (VeloHUD Engine)"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Card 2: Cài Đặt Tự Chạy Khi Khởi Động Xe (Auto-Start Suite) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ TỰ ĐỘNG CHẠY KHI KHỞI ĐỘNG XE (AUTO-START)"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBatteryOptimization"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#059669"
                android:text="🔋 CẤP QUYỀN CHẠY NGẦM KHÔNG GIỚI HẠN PIN (CHỐNG NGẮT KHI NỔ MÁY)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <Switch
                android:id="@+id/swAutoBoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="⚡ Tự bật Bong bóng khi nổ máy xe / Khởi động Android Box"
                android:textColor="#F1F5F9"
                android:textSize="13.5sp" />

            <Switch
                android:id="@+id/swAutoStartOnOpen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="🚀 Tự bật Bong bóng ngay khi mở ứng dụng (Không cần bấm nút)"
                android:textColor="#F1F5F9"
                android:textSize="13.5sp" />

            <Switch
                android:id="@+id/swAutoMinimize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="🔽 Tự thu nhỏ App xuống nền (1.5s) sau khi tự bật Bong bóng"
                android:textColor="#F1F5F9"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- Card 3: Tùy chỉnh Kích thước Siêu Gọn & Độ Trong Suốt Bong Bóng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ GIAO DIỆN BONG BÓNG SIÊU GỌN (TRÁNH CHE BẢN ĐỒ)"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBubbleScaleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kích thước Bong bóng: 100% (Chuẩn gọn 92x48dp)"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbBubbleScale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="60"
                android:progress="30" />

            <TextView
                android:id="@+id/tvIdleAlphaLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Độ rõ nét khi đường thông thoáng (Tự làm mờ): 78%"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbIdleAlpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="50"
                android:progress="28" />

            <Switch
                android:id="@+id/swUltraMiniMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="false"
                android:text="🔒 Chế độ Tối Giản Tuyệt Đối (Chỉ hiện 2 vòng tròn, không bung nhãn Camera ngang)"
                android:textColor="#F1F5F9"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Card 4: Cài đặt Cảnh báo & Giọng nói Phòng thu MP3 Offline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ CÀI ĐẶT CẢNH BÁO TỐC ĐỘ &amp; GIỌNG NÓI PHÒNG THU MP3"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOverspeedThresholdLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ngưỡng báo động vượt tốc độ: +3 km/h"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbOverspeedThreshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="10"
                android:progress="3" />

            <TextView
                android:id="@+id/tvGpsOffsetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bù độ lệch đồng hồ ODO xe so với GPS: +0 km/h"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbGpsOffset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="10"
                android:progress="5" />

            <Switch
                android:id="@+id/swVoiceAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="🔊 Phát giọng nói Tiếng Việt Phòng thu MP3 (Báo đúng 1 lần trước mỗi biển)"
                android:textColor="#F1F5F9"
                android:textSize="13.5sp" />

            <RadioGroup
                android:id="@+id/rgSoundMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSoundFull"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#38BDF8"
                    android:checked="true"
                    android:text="Giọng nói + Ting"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbSoundDing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#38BDF8"
                    android:text="Chỉ tiếng Ting"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbSoundMute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#38BDF8"
                    android:text="Tắt âm"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Card 5 (ẨN MẶC ĐỊNH - CHỈ DÀNH CHO DEVELOPER DEBUG): Giả lập lộ trình 30km -->
        <LinearLayout
            android:id="@+id/cardDebugSimulation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛠️ CÔNG CỤ DEBUG NỘI BỘ (CHỈ DÀNH CHO LẬP TRÌNH VIÊN / KIỂM THỬ)"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgLocationMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbRealGps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="#38BDF8"
                    android:checked="true"
                    android:text="Chế độ chuẩn: Thu tín hiệu GPS Thực Tế của xe"
                    android:textColor="#F1F5F9"
                    android:textSize="13.5sp" />

                <RadioButton
                    android:id="@+id/rbSimRoute"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:buttonTint="#F59E0B"
                    android:text="[DEBUG] Phát lộ trình giả lập 30km TP.HCM (Chỉ dùng khi test code)"
                    android:textColor="#FDE68A"
                    android:textSize="13.5sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvSimSpeedOverrideLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="[DEBUG] Tốc độ xe giả lập: Tự động theo tuyến đường"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbSimSpeedOverride"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="120"
                android:progress="0" />

            <Button
                android:id="@+id/btnResetSimRoute"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#334155"
                android:text="🔄 Reset tọa độ Debug về 0 km"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
