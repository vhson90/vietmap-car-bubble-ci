<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootBubbleContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bubble_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="3dp"
    android:paddingTop="3dp"
    android:paddingEnd="4dp"
    android:paddingBottom="3dp">

    <!-- Cụm 1: Đồng hồ tốc độ thực tế GPS Siêu Gọn (44dp x 44dp) -->
    <LinearLayout
        android:id="@+id/speedCircleContainer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_speedometer_normal"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCurrentSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#38BDF8"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSpeedUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="km/h"
            android:textColor="#94A3B8"
            android:textSize="7.5sp" />
    </LinearLayout>

    <!-- Cụm 2: Biển báo tốc độ giới hạn hiện tại (42dp x 42dp, cắt tròn sát viền) -->
    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="3dp">

        <ImageView
            android:id="@+id/ivSpeedLimitSign"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:contentDescription="Biển báo tốc độ giới hạn"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:background="#CC0284C7"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:text="SIM"
            android:textColor="#FFFFFF"
            android:textSize="6.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Cụm 3: Nhãn Cảnh báo Thông minh (MẶC ĐỊNH ẨN - Chỉ hiện khi có Camera/Biển báo < 350m) -->
    <LinearLayout
        android:id="@+id/alertExpandPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="5dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivUpcomingAlertIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Biển báo phía trước"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUpcomingAlertDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="150m"
                android:textColor="#FBBF24"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUpcomingAlertName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxWidth="82dp"
                android:maxLines="1"
                android:text="Camera"
                android:textColor="#E2E8F0"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
