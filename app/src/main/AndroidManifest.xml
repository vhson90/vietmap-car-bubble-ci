<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="vn.vietmap.carbubble">

    <!-- Quyền vẽ Bong bóng nổi đè lên trên Google Maps, YouTube, CarPlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Quyền truy cập GPS phần cứng trên Android Box ô tô -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Quyền chạy ngầm Foreground Service liên tục trên Android Box -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Quyền bỏ qua tối ưu hóa pin để Android 12-15 cho phép tự chạy ngầm khi nổ máy xe -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Quyền tự khởi động Bong bóng khi bật chìa khóa nổ máy xe -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_bubble"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_bubble"
        android:supportsRtl="true"
        android:theme="@style/Theme.VietmapCarBubble">

        <!-- Màn hình Dashboard điều khiển trên màn hình xe -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dịch vụ chạy ngầm hiển thị Bong bóng Tốc độ & Giới hạn Offline (Hỗ trợ DirectBoot) -->
        <service
            android:name=".service.FloatingBubbleService"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Tự động bật Bong bóng khi khởi động Android Box ô tô (Boot / QuickBoot / DirectBoot / Update) -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
